{
  "name": "chatlings",
  "productName": "Chatlings",
  "version": "0.2.3",
  "description": "Floating chat heads for every web chat app on your desktop. Multi-account, no telemetry.",
  "main": "src/main/main.js",
  "author": "submit69",
  "license": "MIT",
  "homepage": "https://github.com/submit69/chatlings",
  "repository": {
    "type": "git",
    "url": "https://github.com/submit69/chatlings.git"
  },
  "keywords": [
    "chat-heads",
    "floating",
    "bubble",
    "electron",
    "zalo",
    "messenger",
    "whatsapp",
    "telegram",
    "discord",
    "multi-account"
  ],
  "scripts": {
    "start": "electron .",
    "fake": "node scripts/run-fake.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node test/e2e/run.mjs",
    "mem-report": "node scripts/mem-report.mjs",
    "check-adapters": "node scripts/check-adapters.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/make-demo.mjs",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "video": "node scripts/make-video.mjs",
    "site": "cd site && npm run deploy"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "koffi@3.3.3": true,
    "electron-winstaller@5.4.0": true,
    "ffmpeg-static@5.3.0": true
  }
}
